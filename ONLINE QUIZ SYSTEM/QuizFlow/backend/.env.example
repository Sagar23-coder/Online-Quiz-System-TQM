# ==============================================================================
# QuizFlow Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual settings.
# DO NOT commit your actual .env file or credentials to version control.

# Application Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=QuizFlow
API_V1_STR=/api/v1

# Security & Authentication
# Generate a secure 32-byte secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# For Production (Neon / Render / Supabase PostgreSQL):
# Format: postgresql+psycopg2://<user>:<password>@<neon-host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-example-123456.us-east-2.aws.neon.tech/quizflow?sslmode=require

# For Local Development (SQLite):
# DATABASE_URL=sqlite:///quizflow.db

# Public Web Base URL for Shareable Student Links
# Set this to your deployed Render HTTPS domain so that shared quiz links
# (WhatsApp, Email, Copy Link) open on students' phones and computers worldwide.
PUBLIC_BASE_URL=https://quizflow-backend.onrender.com

# CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS=["https://quizflow-backend.onrender.com","*"]

# Optional: Default Administrator Bootstrap (created automatically on first boot if not existing)
# FIRST_SUPERUSER_EMAIL=admin@quizflow.com
# FIRST_SUPERUSER_PASSWORD=ChangeThisAdminPassword123!
# FIRST_SUPERUSER_NAME=QuizFlow Administrator
