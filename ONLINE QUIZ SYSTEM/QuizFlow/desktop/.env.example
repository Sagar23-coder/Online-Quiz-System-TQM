# ==============================================================================
# QuizFlow Desktop Client Configuration (.env)
# ==============================================================================
# Copy this file to .env inside the desktop/ directory to point your desktop app
# to your deployed cloud backend or local development server.

# Local Development (Default):
# QUIZFLOW_API_URL=http://127.0.0.1:8000/api/v1

# Cloud Production (Render):
# Replace with your actual Render service URL after deployment:
# QUIZFLOW_API_URL=https://quizflow-backend.onrender.com/api/v1
