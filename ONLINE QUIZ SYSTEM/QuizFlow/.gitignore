# ==============================================================================
# QuizFlow 2.0 — Comprehensive Professional .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (STRICT - Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
*.pem
*.key
*.cert
*.pfx
*.crt
id_rsa*
secrets.json

# ------------------------------------------------------------------------------
# 2. SQLite Databases & Backups (STRICT - Never commit user or student data)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
quizflow.db
quizflow_backup*.db
test_quizflow*.db
*.bak
*.sql.gz

# ------------------------------------------------------------------------------
# 3. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 4. Node, React Native & Mobile (Expo)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.pnpm-lock.yaml

# Expo & Mobile artifacts
.expo/
.expo-shared/
web-build/
android/
ios/

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & OS Generated Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.code-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Output
# ------------------------------------------------------------------------------
*.log
logs/
*.dump
crash.dmp
tmp/
scratch/
