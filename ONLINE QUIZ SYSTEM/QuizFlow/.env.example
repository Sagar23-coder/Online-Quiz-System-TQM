# ==============================================================================
# QuizFlow Root Environment Configuration (.env.example)
# ==============================================================================

# Backend Settings
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=QuizFlow
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql+psycopg2://user:password@ep-example-123456.us-east-2.aws.neon.tech/quizflow?sslmode=require

# Public Render Domain for Student Assessment Links
PUBLIC_BASE_URL=https://quizflow-backend.onrender.com
BACKEND_CORS_ORIGINS=["https://quizflow-backend.onrender.com","*"]

# Desktop Client API Target
QUIZFLOW_API_URL=https://quizflow-backend.onrender.com/api/v1
